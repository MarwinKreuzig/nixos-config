default partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1] = "Minecraft";

    // in some cases the keys are also remapped in waywall to move F3 shortcuts around
    // in those cases I included a comment that specifies where the actual key ends up in the final layout

    key <AD01> { [ d, D, VoidSymbol, VoidSymbol ] };
    key <AD02> { [ b, B, VoidSymbol, VoidSymbol ] };
    key <AD03> { [ e, E, VoidSymbol, VoidSymbol ] };
    key <AD04> { [ k, K, VoidSymbol, VoidSymbol ] };
    key <AD07> { [ r, R, VoidSymbol, VoidSymbol ] }; // AD05
    key <AC01> { [ a, A, VoidSymbol, VoidSymbol ] };
    key <AC02> { [ o, O, VoidSymbol, VoidSymbol ] };
    key <AC03> { [ s, S, VoidSymbol, VoidSymbol ] };
    key <AC04> { [ f, F, VoidSymbol, VoidSymbol ] }; // necessary for key repeat to work
    key <AC07> { [ n, N, VoidSymbol, VoidSymbol ] }; // AC04
    key <AB02> { [ i, I, VoidSymbol, VoidSymbol ] };
    key <AB03> { [ t, T, VoidSymbol, VoidSymbol ] };
    key <AB04> { [ w, W, VoidSymbol, VoidSymbol ] };
    key <AB05> { [ c, C, VoidSymbol, VoidSymbol ] };

};
